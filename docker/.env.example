# Copy this file to .env and fill in the token. Never commit .env.
# Token: GitHub > Settings > Developer settings > Fine-grained tokens > Generate new token
#   Repository access: Only select repositories -> furzona-live
#   Permissions: Actions -> Read and write   (nothing else)
GITHUB_TOKEN=
GITHUB_REPO=Kodaijin/furzona-live
NOWPLAYING_URL=https://furzona.radio/api/nowplaying/clubradio
POLL_SECONDS=10
MIN_GAP_SECONDS=30
